digraph G { graph [rankdir=TB, bgcolor="white",nodesep=.25,ranksep=.65,splines=polyline]; node [shape=plain,fontname="DejaVu Sans",fontsize=10]; edge [fontname="DejaVu Sans",fontsize=8,arrowsize=.5];
TimeSlot [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dce9f2"><B>TimeSlot</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- day: int<BR ALIGN="LEFT"/>- startHour: int<BR ALIGN="LEFT"/>- duration: int<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ overlapsWith(other: TimeSlot): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Instructor [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dce9f2"><B>Instructor</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: String<BR ALIGN="LEFT"/>- unavailableSlots: List&lt;TimeSlot&gt;<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ isAvailable(slot: TimeSlot): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Room [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dce9f2"><B>Room</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- type: String<BR ALIGN="LEFT"/>- capacity: int<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ isSuitableFor(session: Session): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Course [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dce9f2"><B>Course</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- code: String<BR ALIGN="LEFT"/>- instructor: Instructor<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ createSessions(): List&lt;Session&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Session [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dce9f2"><B>Session</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- course: Course<BR ALIGN="LEFT"/>- assignedSlot: TimeSlot<BR ALIGN="LEFT"/>- assignedRoom: Room<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ getDuration(): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
SpecialRequest [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dce9f2"><B>SpecialRequest</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- sessionId: String<BR ALIGN="LEFT"/>- mandatory: boolean<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ getRequestType(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
FileDataReader [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dce9f2"><B>FileDataReader</B></TD></TR><HR/><TR><TD ALIGN="LEFT">(no fields)<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ loadRooms(path: String): List&lt;Room&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Timetable [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dce9f2"><B>Timetable</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- sessions: List&lt;Session&gt;<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ getSessions(): List&lt;Session&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
ConstraintChecker [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dce9f2"><B>ConstraintChecker</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- timetable: Timetable<BR ALIGN="LEFT"/>- requests: List&lt;SpecialRequest&gt;<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ checkHard(<BR ALIGN="LEFT"/>  session: Session,<BR ALIGN="LEFT"/>  slot: TimeSlot,<BR ALIGN="LEFT"/>  room: Room<BR ALIGN="LEFT"/>): List&lt;String&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Scheduler [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dce9f2"><B>Scheduler</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- timetable: Timetable<BR ALIGN="LEFT"/>- checker: ConstraintChecker<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ generateTimetable(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
ClassroomRequestGen [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dce9f2"><B>ClassroomRequestGen</B></TD></TR><HR/><TR><TD ALIGN="LEFT">(no fields)<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ generateDraft(<BR ALIGN="LEFT"/>  session: Session,<BR ALIGN="LEFT"/>  suggestedSlot: TimeSlot<BR ALIGN="LEFT"/>): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
ReportWriter [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dce9f2"><B>ReportWriter</B></TD></TR><HR/><TR><TD ALIGN="LEFT">(no fields)<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ renderYear(<BR ALIGN="LEFT"/>  timetable: Timetable,<BR ALIGN="LEFT"/>  year: int<BR ALIGN="LEFT"/>): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Main [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dce9f2"><B>Main</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- input: Scanner<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ main(args: String[]): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Course -> Instructor [dir=none,taillabel="*",headlabel="1",label="teacher"];
Session -> Course [dir=none,taillabel="0..2",headlabel="1",label="course"];
Session -> Room [dir=none,taillabel="*",headlabel="0..1",label="assignedRoom"];
Session -> TimeSlot [dir=none,taillabel="*",headlabel="0..1",label="assignedSlot"];
Instructor -> TimeSlot [dir=none,taillabel="*",headlabel="*",label="availability"];
Room -> TimeSlot [dir=none,taillabel="*",headlabel="*",label="availability"];
Timetable -> Session [dir=none,taillabel="0..1",headlabel="*",label="sessions"];
ConstraintChecker -> Timetable [dir=none,taillabel="*",headlabel="1",label="timetable"];
ConstraintChecker -> SpecialRequest [dir=none,taillabel="*",headlabel="*",label="requests"];
Scheduler -> Timetable [dir=none,taillabel="*",headlabel="1",label="timetable"];
Scheduler -> ConstraintChecker [dir=none,taillabel="*",headlabel="1",label="checker"];
Scheduler -> Room [dir=none,taillabel="*",headlabel="*",label="rooms"];
Scheduler -> SpecialRequest [dir=none,taillabel="*",headlabel="*",label="requests"];
FileDataReader -> Course [style=dashed,label="uses",arrowhead=open];
ReportWriter -> Timetable [style=dashed,label="uses",arrowhead=open];
ClassroomRequestGen -> Session [style=dashed,label="uses",arrowhead=open];
}
